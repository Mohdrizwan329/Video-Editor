<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced the windowBackground launch screen with its own
         SplashScreen API, which ignores @drawable/launch_background and draws
         the launcher icon instead — that is why the stock Flutter mark showed
         up here. These attributes point it at the app's own colour and mark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
